<script>
(function(){
  var tabs = document.querySelectorAll('#tabs button');
  var panels = document.querySelectorAll('.panel');
  tabs.forEach(function(btn){
    btn.addEventListener('click', function(){
      tabs.forEach(function(b){ b.classList.remove('active'); });
      panels.forEach(function(p){ p.classList.remove('active'); });
      btn.classList.add('active');
      var target = document.getElementById(btn.dataset.panel);
      if (target) target.classList.add('active');
    });
  });

  var STORAGE_KEY = 'accenture-plan-triage-v2';
  var ORDER = ['none', 'red', 'yellow', 'green'];
  function loadState(){
    try { var raw = localStorage.getItem(STORAGE_KEY); return raw ? JSON.parse(raw) : {}; }
    catch(e){ return {}; }
  }
  function saveState(state){ try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(e){} }
  var state = loadState();

  var dots = document.querySelectorAll('.tri');
  dots.forEach(function(dot){
    var saved = state[dot.dataset.id];
    if (saved) { dot.setAttribute('data-state', saved); dot.closest('li').classList.toggle('done', saved === 'green'); }
  });

  document.querySelectorAll('ul.checklist li').forEach(function(li){
    li.addEventListener('click', function(){
      var dot = li.querySelector('.tri');
      if (!dot) return;
      var cur = dot.getAttribute('data-state') || 'none';
      var next = ORDER[(ORDER.indexOf(cur) + 1) % ORDER.length];
      if (next === 'none') { dot.removeAttribute('data-state'); delete state[dot.dataset.id]; }
      else { dot.setAttribute('data-state', next); state[dot.dataset.id] = next; }
      li.classList.toggle('done', next === 'green');
      saveState(state);
      updateProgress();
    });
  });

  function updateProgress(){
    ['day1','day2','day3','day4','day5'].forEach(function(day){
      var group = document.querySelectorAll('ul.checklist[data-group="'+day+'"] .tri');
      if (!group.length) return;
      var green = 0;
      group.forEach(function(d){ if (d.getAttribute('data-state') === 'green') green++; });
      var pct = Math.round((green / group.length) * 100);
      var fill = document.getElementById('prog-' + day);
      if (fill) fill.style.width = pct + '%';
    });
  }
  updateProgress();

  var TARGET_KEY = 'accenture-plan-target-v1';
  var btns = document.querySelectorAll('#targetBtns .tbtn');
  var savedTarget = null;
  try { savedTarget = localStorage.getItem(TARGET_KEY); } catch(e){}

  function setActiveBtn(dateStr){ btns.forEach(function(b){ b.classList.toggle('active', b.dataset.date === dateStr); }); }
  function computeDaysLeft(dateStr){
    var today = new Date(); today.setHours(0,0,0,0);
    var target = new Date(dateStr + 'T00:00:00');
    return Math.ceil((target - today) / 86400000);
  }
  function updateCountdown(dateStr){
    var el = document.getElementById('daysLeft');
    if (!dateStr) { el.textContent = '–'; return; }
    var diff = computeDaysLeft(dateStr);
    el.textContent = diff > 0 ? diff : (diff === 0 ? 'Today' : '—');
  }
  btns.forEach(function(b){
    b.addEventListener('click', function(){
      setActiveBtn(b.dataset.date);
      try { localStorage.setItem(TARGET_KEY, b.dataset.date); } catch(e){}
      updateCountdown(b.dataset.date);
    });
  });

  var initialTarget = savedTarget || '2026-09-28';
  setActiveBtn(initialTarget);
  updateCountdown(initialTarget);
})();
</script>
</body>
